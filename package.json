{
  "name": "arnav-flight-radar",
  "version": "1.0.0",
  "private": true,
  "description": "Arnav Flight Radar — a premium, free, honest live aircraft tracker on Cloudflare Workers.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-airports.mjs && vite build",
    "preview": "vite build && vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:airports": "node scripts/build-airports.mjs",
    "brand": "node brand/scripts/build-logo.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@photostructure/tz-lookup": "^11.7.0",
    "@tanstack/react-query": "^5.104.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.14.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
