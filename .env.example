# Arnav Flight Radar needs NO secrets to run: every data source is keyless and all
# aircraft are simulated in the browser. These variables are only for tooling.

# End-to-end tests against a deployed site instead of the local dev server.
# BASE_URL=https://arnav-flight-radar.<your-subdomain>.workers.dev

# GitHub Actions deployment (set as repository *secrets*, never in this file):
# CLOUDFLARE_API_TOKEN=   # token with "Edit Cloudflare Workers" permission
# CLOUDFLARE_ACCOUNT_ID=

# Optional limits for `npm run data:ground` (OpenStreetMap stands and taxiways):
# GROUND_AIRPORTS=25      # how many of the busiest simulated hubs to consider
# GROUND_BUDGET_MIN=10    # Overpass time budget per run, in minutes

# Runtime settings live in wrangler.jsonc "vars" (public, non-secret):
#   WEATHER_MIN_INTERVAL_MS  spacing of AviationWeather.gov calls (default 1500)
#   APP_VERSION              version reported by /api/health and /api/config
#   CONTACT_URL              source link reported by /api/config
